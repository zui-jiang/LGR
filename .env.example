# Copy this file to .env and fill in local values.
# .env is intentionally ignored by git.

PROJECT_DIR=/absolute/path/to/slime-tree-experiment

# Local code checkouts.
SLIME_PATH=${PROJECT_DIR}/slime_tree
SGLANG_PATH=${PROJECT_DIR}/sg_tree
MEGATRON_PATH=/absolute/path/to/Megatron-LM-Slime

# Teacher model services.
TEACHER_IP=
TEACHER_PORT=8000
TEACHER_NAME=sky-7_dasd
TREE_TEACHER_NAME=sky-7_tree

# Training data and model storage.
HF_MODEL_DIR=/absolute/path/to/hf_models
HF_DATASET_DIR=/absolute/path/to/hf_datasets

# Distributed training knobs.
WORLD_SIZE=1
TENSOR_MODEL_PARALLEL_SIZE=1
RESUME_NUM_ROLLOUT=0

# Optional W&B configuration. Do not commit real secrets.
WANDB_KEY=
WANDB_ENTITY=zuijiang
WANDB_PROJECT=slime-1.5b-guidev2-opd
WANDB_CACHE_DIR=${PROJECT_DIR}/.cache/wandb/cache
WANDB_CONFIG_DIR=${PROJECT_DIR}/.cache/wandb/config
WANDB_DIR=${PROJECT_DIR}/.cache/wandb/run
WANDB_ARTIFACT_DIR=${PROJECT_DIR}/.cache/wandb/artifacts
