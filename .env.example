# Copy to .env at the repository root. This file uses Bash assignment syntax.
# .env is sourced as shell code: use trusted local contents only.
# Paths below are examples; replace them before launching training.
# PROJECT_DIR defaults to this repository. Do not set it to a placeholder.
MEGATRON_PATH=/absolute/path/to/Megatron-LM
HF_MODEL_DIR=/absolute/path/to/models
HF_DATASET_DIR=/absolute/path/to/datasets

# Optional exact paths; otherwise derived from the roots above.
# STUDENT_CHECKPOINT=/path/to/DeepSeek-R1-Distill-Qwen-1.5B
# REF_CHECKPOINT=/path/to/DeepSeek-R1-Distill-Qwen-1.5B-dist
# TRAIN_DATA=/path/to/polaris-data-53K_slime.jsonl
# EVAL_DATA=/path/to/aime-2024.jsonl

# Same teacher weights/tokenizer for ordinary scoring and tree scoring.
TEACHER_IP=127.0.0.1
TEACHER_PORT=8000
TEACHER_NAME=math-teacher
TREE_TEACHER_NAME=${TEACHER_NAME}
TEACHER_WAIT_SECONDS=600
# Optional space-separated tree scoring endpoints; no Consul required.
# CONFIDENCE_URLS="http://host1:8000/generate http://host2:8000/generate"
# Optional legacy discovery, used only if CONFIDENCE_URLS is empty.
# CONSUL_URL=http://consul-host:8500/v1/kv/ray-nodes/?recurse=true

# WORLD_SIZE means training node count here. Each node uses 8 GPUs.
WORLD_SIZE=1
TENSOR_MODEL_PARALLEL_SIZE=1
RAY_ADDRESS=http://127.0.0.1:8265
EXP_NAME=exp258-distill-1.5B-v3

# Training configuration.
NUM_ROLLOUT=3000
UNION_TOPK=20
LGR_NORMALIZE_STD=0
LGR_ALTERNATE_STEPS=2
MAX_TREE_TOKENS=18000

# Optional experiment tracking. W&B is disabled by default.
USE_WANDB=0
WANDB_KEY=
WANDB_ENTITY=
WANDB_PROJECT=lgr
